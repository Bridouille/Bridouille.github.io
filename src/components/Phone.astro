---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Draws an Android status bar above screenshots that were captured without one. */
  statusBar?: boolean;
  eager?: boolean;
  class?: string;
}

const { src, alt, statusBar = false, eager = false, class: className } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---

<div class:list={['phone', className]}>
  {
    statusBar ? (
      <div class="with-status-bar">
        <svg viewBox="0 0 411 24" aria-hidden="true">
          <text x="20" y="16.5" font-family="Roboto Variable, Inter Variable, sans-serif" font-size="12.5" font-weight="500" fill="#EEF2F5">10:30</text>
          <g fill="#EEF2F5">
            <path d="M343 9.5a10 10 0 0 1 14 0l-7 7.5z" />
            <path d="M362 17h2v-3h-2zM365.5 17h2v-5.5h-2zM369 17h2v-8h-2z" />
            <rect x="376" y="8" width="16" height="9" rx="2.2" />
            <rect x="392.5" y="10.5" width="1.6" height="4" rx="0.8" />
          </g>
        </svg>
        <Image src={src} alt={alt} loading={loading} />
      </div>
    ) : (
      <Image src={src} alt={alt} loading={loading} />
    )
  }
</div>

<style>
  .phone {
    aspect-ratio: 9 / 16;
    border: 6px solid var(--phone-border, #0b1220);
    border-radius: var(--phone-radius, 22px);
    overflow: hidden;
    background: #000000;
    flex: none;
  }

  .phone :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .with-status-bar {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background: #0e1418;
  }

  .with-status-bar svg {
    display: block;
    width: 100%;
    flex: none;
  }

  .with-status-bar :global(img) {
    flex: 1;
    min-height: 0;
    object-fit: contain;
  }
</style>
